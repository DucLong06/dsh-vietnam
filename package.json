{
  "name": "dsh-vietnam",
  "version": "0.1.0",
  "description": "DSH Việt Nam — Vietnamese locale, Vietnamese palettes and a rotating Vietnam-landscape backdrop for DeepSeek Harness",
  "license": "MIT",
  "author": "Hoang Duc Long",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DucLong06/dsh-vietnam.git"
  },
  "homepage": "https://github.com/DucLong06/dsh-vietnam#readme",
  "bugs": {
    "url": "https://github.com/DucLong06/dsh-vietnam/issues"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "dsh-plugin",
    "vietnamese",
    "vietnam",
    "theme",
    "i18n"
  ],
  "type": "module",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "LICENSE",
    "*.map"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-theme",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-renderer"
      ],
      "platform": "web"
    },
    "compatibility": {
      "dsh": ">=0.2.0-rc.1",
      "profiles": [
        "web",
        "desktop"
      ],
      "dshReleases": {
        "0.2.0-rc.2": "compatible"
      }
    }
  },
  "scripts": {
    "build": "tsdown",
    "watch": "tsdown --watch",
    "typecheck": "tsc --noEmit -p tsconfig.vitest.json",
    "test": "vitest run",
    "dev:dsh": "bash scripts/dev-dsh.sh",
    "prepublishOnly": "npm run typecheck && npm test && npm run build && git diff --exit-code -- lib"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "~4.0.4",
    "@deepseek-ai/dsh-client-locale": "0.2.0-rc.2",
    "@deepseek-ai/dsh-client-store": "^0.2.0-rc.2",
    "@deepseek-ai/dsh-client-ui-primitives": "^0.2.0-rc.2",
    "@deepseek-ai/dsh-client-ui-renderer": "0.2.0-rc.2",
    "@deepseek-ai/dsh-client-ui-settings": "0.2.0-rc.2",
    "@deepseek-ai/dsh-client-ui-slots": "^0.2.0-rc.2",
    "@deepseek-ai/dsh-client-ui-theme": "0.2.0-rc.2",
    "@types/node": "^24.0.0",
    "@types/react": "~18.3.1",
    "lightningcss": "^1.32.0",
    "react": "^18.3.1",
    "tsdown": "^0.22.2",
    "typescript": "^5.7.0",
    "vitest": "^4.1.8"
  },
  "publishConfig": {
    "access": "public"
  }
}
